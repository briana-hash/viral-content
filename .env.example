# Required: pulls videos from TikTok, Instagram, Facebook and YouTube.
# Create a token at https://console.apify.com/settings/integrations
APIFY_TOKEN=

# Required for breakdowns and strategy reports. Leave unset if you are signed in with `ant auth login`.
ANTHROPIC_API_KEY=

# Optional: speech-to-text for breakdowns (ElevenLabs Scribe, same key video-use uses).
# Without it, breakdowns fall back to the platform's own captions/subtitles when available.
ELEVENLABS_API_KEY=

# Optional
PORT=3020
# Claude model for breakdowns and reports
CLAUDE_MODEL=claude-opus-5-5
